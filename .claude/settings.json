{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/preflight_hook.py\" || true",
            "timeout": 900,
            "statusMessage": "Running preflight if this is a git push"
          }
        ]
      }
    ]
  }
}
