# Copy to ~/srv/agent/agent.env on the home server (chmod 600). Mirrors the former
# Cloud Run production runtime map in infra/gcp/cloud_run.tf.
AEGRA_CONFIG=/app/aegra.json
BG_JOB_MAX_RETRIES=0
ENV_MODE=PRODUCTION
FF_V2_EVENT_STREAMING=true
LANGGRAPH_MAX_POOL_SIZE=4
LANGGRAPH_MIN_POOL_SIZE=1
MODEL=openai:gpt-5.6-luna
REDIS_BROKER_ENABLED=false
RUN_MIGRATIONS_ON_STARTUP=false
SQLALCHEMY_MAX_OVERFLOW=0
SQLALCHEMY_POOL_SIZE=2

AGENT_ANONYMOUS_ACCESS_ENABLED=true
GUEST_MODEL=openai:gpt-5.6-luna
GUEST_DAILY_BUDGET_MICRO_USD=500000
GUEST_RUN_RESERVATION_MICRO_USD=53837

# postgresql://agent:<POSTGRES_PASSWORD from .env>@postgres:5432/agent
DATABASE_URL=

# Same value as Vercel Production AGENT_AUTH_SECRET. Generate with: openssl rand -hex 32
AGENT_AUTH_SECRET=
OPENAI_API_KEY=

LANGCHAIN_TRACING_V2=true
LANGCHAIN_CALLBACKS_BACKGROUND=false
LANGCHAIN_PROJECT=syshin0116's dev (home)
LANGCHAIN_API_KEY=
