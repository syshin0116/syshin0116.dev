<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Install: replace HOME_DIR, copy to ~/Library/LaunchAgents/, then
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.syshin0116.agent-deploy.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.syshin0116.agent-deploy</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>HOME_DIR/srv/agent/deploy.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>HOME_DIR/srv/agent/deploy.log</string>
  <key>StandardErrorPath</key>
  <string>HOME_DIR/srv/agent/deploy.log</string>
</dict>
</plist>
